# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=saath_db

# Email / SMTP Configuration (e.g. Gmail with App Password or other SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@saath.local

# OTP Settings
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_HMAC_SECRET=replace_with_a_secure_random_hmac_secret_key

# Application & Frontend URLs
FRONTEND_URL=http://localhost:5173

# Optional: Set to 'true' in development to mock email sending without real SMTP credentials
MOCK_EMAIL=true

# LLM / Gemini (Optional - runs offline rule-based if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
