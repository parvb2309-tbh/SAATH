# Project UDAAN environment configuration. Copy to .env and fill in.

# LLM / Gemini (optional). Without a key, UDAAN runs fully offline (deterministic rule-based engine).
# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# SQLite database for platform data (defaults to backend/udaan.db)
UDAAN_DB=udaan.db

# MongoDB (accounts, sign-in codes and tokens)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=saath_db

# Email / SMTP (e.g. Gmail with an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@saath.local

# OTP settings
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_HMAC_SECRET=replace_with_a_secure_random_hmac_secret_key

# Frontend URL (used in emails)
FRONTEND_URL=http://localhost:5173

# Set to true in development to mock email sending without real SMTP credentials
MOCK_EMAIL=true
